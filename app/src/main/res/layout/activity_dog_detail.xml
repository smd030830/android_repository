<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_gray">

    <TextView
        android:id="@+id/tvDetailDogName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="강아지 이름"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewDiaries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvEmptyDiaries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="아직 작성된 일지가 없습니다."
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <android.widget.Button
        android:id="@+id/btnGoWrite"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="일지 작성하기"
        android:textColor="@color/white"
        android:background="@drawable/bg_button_rounded"
        android:visibility="gone" />

    <android.widget.Button
        android:id="@+id/btnGoMessage"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="임시보호자에게 문의하기"
        android:textColor="@color/white"
        android:background="@drawable/bg_button_rounded"
        android:visibility="gone" />

</LinearLayout>
